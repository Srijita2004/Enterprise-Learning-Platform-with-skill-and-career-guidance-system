# =========================================================================
# SkillSphere Nexus - Environment Configuration Template
# -------------------------------------------------------------------------
# Copy this file to '.env' and replace placeholder values with your own:
#   cp .env.example .env
#
# NOTE: Never commit your actual '.env' file containing real secrets to
# version control. '.env' is automatically ignored by git.
# =========================================================================

# 1. Google Gemini AI API Configuration (Optional - offline fallback enabled)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DB_URL=jdbc:postgresql://localhost:5432/skillsphere

# 3. Cryptographic JWT Authentication Secret (RFC 7519 HMAC-SHA256)
# Must be at least 256 bits (32+ characters) long for production security
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_here

# 4. Apache Kafka Distributed Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 5. Service Discovery (Netflix Eureka)
EUREKA_SERVER_URL=http://localhost:8761/eureka/
